{
  "name": "cicekliscript",
  "displayName": "CicekliScript",
  "description": "CicekliScript dili desteği (.ccl) — Sözdizimi renklendirme, dosya logosu, zengin snippet'lar ve tek tıkla çalıştırma.",
  "version": "1.0.0",
  "publisher": "cicekliscript",
  "repository": {
    "type": "git",
    "url": "https://github.com/cicekliscript/cicekliscript"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Themes"
  ],
  "keywords": [
    "cicekliscript",
    "ccl",
    "cicekli",
    "metescript",
    "ms",
    "programming language",
    "python-like",
    "c-based"
  ],
  "icon": "icons/logo.png",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:cicekliscript",
    "onLanguage:metescript",
    "workspaceContains:**/*.ccl",
    "workspaceContains:**/*.cicekli",
    "workspaceContains:**/*.ms"
  ],
  "contributes": {
    "languages": [
      {
        "id": "cicekliscript",
        "aliases": [
          "CicekliScript",
          "cicekliscript",
          "ccl",
          "MeteScript",
          "metescript"
        ],
        "extensions": [
          ".ccl",
          ".cicekli",
          ".ms",
          ".metescript"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/ccl.svg",
          "dark": "./icons/ccl.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "cicekliscript",
        "scopeName": "source.cicekliscript",
        "path": "./syntaxes/cicekliscript.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "cicekliscript",
        "path": "./snippets/cicekliscript.code-snippets.json"
      }
    ],
    "iconThemes": [
      {
        "id": "cicekliscript-icons",
        "label": "CicekliScript File Icons (.ccl)",
        "path": "./icons/icon-theme.json"
      }
    ],
    "commands": [
      {
        "command": "cicekliscript.run",
        "title": "CicekliScript: Dosyayı Çalıştır",
        "icon": "$(play)"
      },
      {
        "command": "cicekliscript.runInTerminal",
        "title": "CicekliScript: Entegre Terminalde Çalıştır",
        "icon": "$(terminal)"
      },
      {
        "command": "cicekliscript.runSelection",
        "title": "CicekliScript: Seçili Kodu Çalıştır",
        "icon": "$(play)"
      },
      {
        "command": "cicekliscript.openDocs",
        "title": "CicekliScript: Dokümantasyon & Online Derleyiciyi Aç",
        "icon": "$(book)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "cicekliscript.run",
          "when": "editorLangId == cicekliscript || editorLangId == metescript || resourceExtname == .ccl || resourceExtname == .cicekli || resourceExtname == .ms",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "cicekliscript.run",
          "when": "editorLangId == cicekliscript || editorLangId == metescript || resourceExtname == .ccl || resourceExtname == .cicekli || resourceExtname == .ms",
          "group": "1_run@1"
        },
        {
          "command": "cicekliscript.runSelection",
          "when": "editorHasSelection && (editorLangId == cicekliscript || editorLangId == metescript)",
          "group": "1_run@2"
        }
      ],
      "explorer/context": [
        {
          "command": "cicekliscript.run",
          "when": "resourceExtname == .ccl || resourceExtname == .cicekli || resourceExtname == .ms || resourceExtname == .metescript",
          "group": "1_run"
        }
      ]
    },
    "keybindings": [
      {
        "command": "cicekliscript.run",
        "key": "ctrl+f5",
        "mac": "cmd+f5",
        "when": "editorLangId == cicekliscript || editorLangId == metescript || resourceExtname == .ccl || resourceExtname == .cicekli || resourceExtname == .ms"
      }
    ],
    "configuration": {
      "title": "CicekliScript",
      "properties": {
        "cicekliscript.executablePath": {
          "type": "string",
          "default": "",
          "description": "CicekliScript ikili dosyasının (cicekliscript) tam yolu. Boş bırakılırsa sistem PATH ve ~/.local/bin/cicekliscript otomatik aranır."
        },
        "cicekliscript.clearTerminalBeforeRun": {
          "type": "boolean",
          "default": true,
          "description": "Kodu çalıştırmadan önce terminali temizle."
        }
      }
    }
  }
}