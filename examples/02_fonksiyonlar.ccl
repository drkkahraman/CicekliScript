# CicekliScript - Fonksiyon Tanımlama Örnekleri

// 1. İsimli Fonksiyon (cicekli.deffunction)
cicekli.deffunction topla(a, b) {
    return a + b;
};

cicekli.println("3 + 5 =", topla(3, 5));

// 2. Değişkene Atanan Anonim Fonksiyon
carp = cicekli.deffunction(x, y) {
    return x * y;
};

cicekli.println("4 * 6 =", carp(4, 6));

// 3. Parametresiz ve Hemen Çalıştırılan Fonksiyon
cicekli.deffunction() {
    cicekli.println("Hemen çalışan anonim fonksiyon bloğu!");
}();

// 4. Varsayılan def sözdizimi de desteklenir:
def selamla(ad) {
    cicekli.println("Selamlar sana,", ad);
};

selamla("Mete");
