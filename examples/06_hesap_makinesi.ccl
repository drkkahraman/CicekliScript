# CicekliScript - Hesap Makinesi Fonksiyonları

cicekli.deffunction hesapla(a, b, islem) {
    if (islem == "+") {
        return a + b;
    } elif (islem == "-") {
        return a - b;
    } elif (islem == "*") {
        return a * b;
    } elif (islem == "/") {
        if (b == 0) {
            return "Hata: Sıfıra bölünemez!";
        };
        return a / b;
    } elif (islem == "%") {
        return a % b;
    } else {
        return "Bilinmeyen işlem!";
    };
};

cicekli.println("10 + 5 =", hesapla(10, 5, "+"));
cicekli.println("10 - 5 =", hesapla(10, 5, "-"));
cicekli.println("10 * 5 =", hesapla(10, 5, "*"));
cicekli.println("10 / 5 =", hesapla(10, 5, "/"));
cicekli.println("10 % 3 =", hesapla(10, 3, "%"));
cicekli.println("10 / 0 =", hesapla(10, 0, "/"));
