# CicekliScript - Basit GUI Pencere Örneği
// Kullanıcının istediği tam sözdizimi:

window = cicekli.window(100, 100);

// Arka plan rengini ayarla
window.color();

// Pencereye yazı ekle: window.text(metin, renk, boyut, x, y);
window.text("Mete", "red", 16, 20, 35);

cicekli.println("Pencere oluşturuldu! Kapatmak için pencereyi kapatın veya ESC tuşuna basın.");

// Pencere olay döngüsü (kullanıcı kapatana kadar açık tutar)
window.mainloop();
