// ============================================================================
// CicekliScript ile Sıfırdan Otoregresif Dil Modeli (Language Model - SLM)
// ============================================================================

cicekli.println("══════════════════════════════════════════════════════════════");
cicekli.println("🤖 CicekliScript Doğal Dil İşleme & Otoregresif Dil Modeli");
cicekli.println("══════════════════════════════════════════════════════════════");

// 1. Eğitim Külliyatı (Training Corpus)
egitim_metinleri = [
    "cicekli script modern ve guclu bir programlama dilidir",
    "cicekli script ile yapay zeka modelleri kodlanabilir",
    "cicekli script python kolayligi ve c dili performansini birlestirir",
    "yapay zeka gelecegin en onemli teknolojisidir",
    "yapay zeka modelleri veri ile ogrenir ve tahmin yapar",
    "dil modelleri metin uretimi ve anlama gorevlerinde basarilidir",
    "programlama ogrenmek analitik dusunme becerisini gelistirir",
    "cicekli script icinde her cümlenin sonuna noktali virgul konulur",
    "c dili hizli calisan sistem programlama dilidir",
    "yapay sinir aglari gradyan inisi ile optimize edilir"
];

cicekli.println("[1] Eğitim veri kümesi yükleniyor: ", egitim_metinleri.len(), " cümle...");

// 2. Tokenization & Bigram İstatistik Tablosu (N-Gram Transition Probabilities)
gecis_sayilari = {}; // P(w2 | w1) için sayım matrisi
kelime_toplamlari = {}; // Her kelimenin toplam çıkış sayısı
kelime_kumesi = {}; // Sözlük (Vocabulary)

for (cumle in egitim_metinleri) {
    kelimeler = cumle.split(" ");
    toplam_kelime = kelimeler.len();

    for (i = 0; i < toplam_kelime - 1; i = i + 1) {
        mevcut = kelimeler[i];
        sonraki = kelimeler[i + 1];

        // Sözlüğe ekle
        kelime_kumesi[mevcut] = true;
        kelime_kumesi[sonraki] = true;

        if (!gecis_sayilari.has_key(mevcut)) {
            gecis_sayilari[mevcut] = {};
            kelime_toplamlari[mevcut] = 0;
        };

        if (!gecis_sayilari[mevcut].has_key(sonraki)) {
            gecis_sayilari[mevcut][sonraki] = 0;
        };

        gecis_sayilari[mevcut][sonraki] = gecis_sayilari[mevcut][sonraki] + 1;
        kelime_toplamlari[mevcut] = kelime_toplamlari[mevcut] + 1;
    };
};

sozluk_boyutu = kelime_kumesi.keys().len();
cicekli.println("[2] Dil modeli eğitildi. Sözlük (Vocabulary) boyutu:", sozluk_boyutu, "eşsiz kelime.");

// 3. Olasılık Hesaplama Fonksiyonu P(sonraki | mevcut)
def olasilik_hesapla(mevcut, sonraki) {
    if (!gecis_sayilari.has_key(mevcut)) {
        return 0.0;
    };
    if (!gecis_sayilari[mevcut].has_key(sonraki)) {
        return 0.0;
    };
    pay = gecis_sayilari[mevcut][sonraki];
    payda = kelime_toplamlari[mevcut];
    return pay / (payda * 1.0);
};

// 4. Sonraki En Olası Kelimeyi Tahmin Etme (Greedy / Argmax Decoding)
def sonraki_kelimeyi_sec(mevcut) {
    if (!gecis_sayilari.has_key(mevcut)) {
        return null;
    };

    adaylar = gecis_sayilari[mevcut];
    aday_kelimeler = adaylar.keys();

    en_iyi_kelime = null;
    en_yuksek_skor = -1;

    for (aday in aday_kelimeler) {
        skor = adaylar[aday];
        if (skor > en_yuksek_skor) {
            en_yuksek_skor = skor;
            en_iyi_kelime = aday;
        };
    };

    return en_iyi_kelime;
};

// 5. Otoregresif Metin Üretimi (Autoregressive Text Generation)
def metin_uret(baslangic_kelimesi, maksimum_uzunluk) {
    uretilen = [baslangic_kelimesi];
    su_anki = baslangic_kelimesi;

    for (adim = 0; adim < maksimum_uzunluk; adim = adim + 1) {
        sonraki = sonraki_kelimeyi_sec(su_anki);
        if (sonraki == null) {
            break; // Tahmin zinciri bitti
        };
        uretilen.append(sonraki);
        su_anki = sonraki;
    };

    return uretilen.join(" ");
};

// 6. Test ve Çıktı Gösterimi
cicekli.println("\n══════════════════════════════════════════════════════════════");
cicekli.println("📊 Olasılık Dağılımı İncelemesi:");
cicekli.println("══════════════════════════════════════════════════════════════");

ornek_kelimeler = ["cicekli", "yapay", "dil"];

for (k in ornek_kelimeler) {
    if (gecis_sayilari.has_key(k)) {
        cicekli.println("• P( ... | '" + k + "' ) olasılıkları:");
        adaylar = gecis_sayilari[k].keys();
        for (a in adaylar) {
            p = olasilik_hesapla(k, a);
            yuzde = math.round(p * 100);
            cicekli.println("   -> '" + a + "'  olasılık: %" + yuzde + " (" + p + ")");
        };
    };
};

cicekli.println("\n══════════════════════════════════════════════════════════════");
cicekli.println("✍️  Otoregresif Üretim Sonuçları (Text Generation):");
cicekli.println("══════════════════════════════════════════════════════════════");

promptlar = ["cicekli", "yapay", "programlama", "dil"];

for (p in promptlar) {
    sonuc = metin_uret(p, 8);
    cicekli.println("Prompt: '" + p + "'");
    cicekli.println("Üretilen Cümle: -> \"" + sonuc + "\"\n");
};

// 7. Model Başarısı: Ortalama Negatif Log-Likelihood (Loss)
toplam_nll = 0.0;
nll_sayisi = 0;

for (cumle in egitim_metinleri) {
    kelimeler = cumle.split(" ");
    for (i = 0; i < kelimeler.len() - 1; i = i + 1) {
        prob = olasilik_hesapla(kelimeler[i], kelimeler[i + 1]);
        if (prob > 0.0) {
            toplam_nll = toplam_nll - math.log(prob);
            nll_sayisi = nll_sayisi + 1;
        };
    };
};

ortalama_kayip = toplam_nll / nll_sayisi;
cicekli.println("Model Eğitimi Kayıp Değeri (Cross-Entropy / NLL Loss):", ortalama_kayip);
cicekli.println("══════════════════════════════════════════════════════════════");
